# Copy this file to .env and edit it:   cp .env.example .env
# ==============================================================================
#
#   >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#   >>>                                                                  <<<
#   >>>   STEP 1 (THE ONLY THING YOU MUST EDIT):                         <<<
#   >>>                                                                  <<<
#   >>>   Put your Groq API key on the GROQ_API_KEY line just below.     <<<
#   >>>   Get a free key at  https://console.groq.com/keys               <<<
#   >>>                                                                  <<<
#   >>>   Replace  PASTE_YOUR_GROQ_KEY_HERE  with the key (starts gsk_)  <<<
#   >>>   No quotes, no spaces.   Never commit this file to git.         <<<
#   >>>                                                                  <<<
#   >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#
# ==============================================================================
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
FAKE_MODELS=false              # true = fake answers, no Groq calls, no key needed

# ------------------------------------------------------------------------------
# Auth (backend -> this service). RS256 JWT, audience "discovery-ai".
# LOCAL DEVELOPMENT: leave AUTH_DISABLED=true so you can call the API with curl.
# STAGING / PRODUCTION: set AUTH_DISABLED=false and give the backend PUBLIC key
# (path below, or paste the PEM into JWT_PUBLIC_KEY using \n for line breaks).
# ------------------------------------------------------------------------------
AUTH_DISABLED=true
JWT_AUDIENCE=discovery-ai
# JWT_PUBLIC_KEY_FILE=.keys/jwt_public.pem
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
# JWT_ISSUER=

# ------------------------------------------------------------------------------
# Interview language: ar (Arabic, English programming terms) or en (English).
# This ONE line picks the prompts, speech-to-text language, voice and first question.
# Only set STT_LANGUAGE / TTS_MODEL / TTS_VOICE / PROMPT_*_VERSION / OPENING_QUESTION
# below if you want to override what the language picks.
# ------------------------------------------------------------------------------
INTERVIEW_LANGUAGE=ar

# ------------------------------------------------------------------------------
# Models (Groq). Change here, no code change needed.
# FREE PLAN TIP: 20b and 120b have separate quotas, so they back each other up.
# BEFORE PRODUCTION: check https://console.groq.com/docs/models (names change).
# ------------------------------------------------------------------------------
LLM_TURN_MODEL=openai/gpt-oss-20b
LLM_TURN_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_RESULT_MODEL=openai/gpt-oss-120b
LLM_RESULT_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TURN_REASONING_EFFORT=low
LLM_RESULT_REASONING_EFFORT=medium
# Speech-to-text provider: groq (Whisper, default) or elevenlabs (Scribe v2, much more accurate on
# Egyptian Arabic + English words). With elevenlabs, Groq Whisper is still used automatically if it fails.
STT_PROVIDER=groq
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
STT_MODEL=whisper-large-v3         # try whisper-large-v3-turbo if it is too slow
# STT_LANGUAGE=ar                     # Arabic interview (English programming words still OK)
# Text-to-speech provider: groq (Orpheus Arabic) or elevenlabs (more natural; needs ELEVENLABS_VOICE_ID
# from https://elevenlabs.io/app/voice-library , filter language Arabic). Orpheus is the automatic fallback.
TTS_PROVIDER=groq
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Orpheus Arabic voice (Saudi accent): fahad, sultan, abdullah (male) / noura, lulwa, aisha (female)
# Orpheus may require accepting its terms once in the Groq console (Playground).
# English instead: TTS_MODEL=canopylabs/orpheus-v1-english  TTS_VOICE=autumn  STT_LANGUAGE=en  PROMPT_*_VERSION=v1
# TTS_MODEL=canopylabs/orpheus-arabic-saudi
# TTS_VOICE=fahad

# Prompts: v2 = Arabic interview with English programming terms, v1 = English
# PROMPT_TURN_VERSION=v2
# PROMPT_RESULT_VERSION=v2

# ------------------------------------------------------------------------------
# Token savers for the Groq FREE plan (8,000 tokens per minute per model).
# Lower these if you see 429 / 413 errors. Raise them when you pay.
# ------------------------------------------------------------------------------
PROFILE_MAX_CHARS_TURN=300
PROFILE_MAX_CHARS_RESULT=600
INCLUDE_TRACKS_IN_TURN=true

# ------------------------------------------------------------------------------
# Student assistant (chatbot, assistant/): POST /v1/assistant/replies
# Every name starts with ASSISTANT_. It uses the same GROQ_API_KEY as above.
# FAKE_MODELS=true above also gives the assistant fake answers.
# ------------------------------------------------------------------------------
ASSISTANT_LLM_MODEL=groq:llama-3.3-70b-versatile   # "provider:model", or "fake"
# ASSISTANT_LLM_TEMPERATURE=0.3
# ASSISTANT_MAX_STEPS=4
# ASSISTANT_REPLY_TIMEOUT_SECONDS=18
# The backend signs the assistant's calls with ITS OWN key pair (audience "assistant-ai"),
# not the Discovery one. LOCAL DEVELOPMENT: ASSISTANT_AUTH_DISABLED=true.
ASSISTANT_AUTH_DISABLED=true
# ASSISTANT_AUTH_PUBLIC_KEY_FILE=.keys/assistant_public.pem
# ASSISTANT_AUTH_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
# Test chat page http://127.0.0.1:8000/assistant/ with 8 mock students. Local only (ignored in production).
ASSISTANT_DEV_ENDPOINTS=true

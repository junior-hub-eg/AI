# Copy to .env and fill in.

# "provider:model" — install the provider package from requirements.txt and set its API key.
# "fake" needs no key: it only checks the wiring with keyword-based answers.
LLM_MODEL=fake
# LLM_MODEL=cohere:command-a-03-2025   (pip install langchain-cohere)
# COHERE_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
LLM_TEMPERATURE=0.3
# "any" forces a tool call every turn; use "auto" if your provider rejects forced tools.
LLM_TOOL_CHOICE=any
MAX_STEPS=4
REPLY_TIMEOUT_SECONDS=18

# Service token from the backend (RS256, audience assistant-ai). For local tests without the backend:
AUTH_DISABLED=true
# AUTH_PUBLIC_KEY_FILE=assistant-ai-public.pem
# AUTH_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# /v1/dev/personas and /v1/dev/chat: chat as a mock student without a token. Never in production.
DEV_ENDPOINTS=true
